# Recorder Service Configuration
# Copy this file to .env and configure as needed

# Communication mode: 'local' or 'remote'
# - local: Spawn recorder_core.exe as child process (default)
# - remote: Connect to remote recorder_core.exe via TCP socket
RECORDER_MODE=local

# For local mode: Path to recorder_core.exe (optional, auto-detected if not set)
# RECORDER_CORE_PATH=C:\path\to\recorder_core.exe

# For remote mode: Remote host IP address
RECORDER_HOST=192.168.1.100

# For remote mode: Remote host port (default: 8765)
RECORDER_PORT=8765
